{
  "env": {
    "node": true,
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-empty": [
      "warn",
      {
        "allowEmptyCatch": false
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "comma-dangle": ["error", "only-multiline"],
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  },
  "overrides": [
    {
      "files": ["whatshybrid-backend/**/*.js"],
      "rules": {
        "no-console": "warn"
      }
    },
    {
      "files": ["whatshybrid-extension/**/*.js"],
      "env": {
        "webextensions": true
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/__tests__/**/*.js", "**/*.test.js", "**/*.spec.js"],
      "env": {
        "jest": true
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "*.min.js",
    "whatshybrid-backend/prisma/migrations",
    "whatshybrid-extension/_deprecated"
  ]
}
