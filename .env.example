# ════════════════════════════════════════════════════════════════════════════
# WhatsHybrid Pro — Configuração de Produção
# ════════════════════════════════════════════════════════════════════════════
#
# Este arquivo é um TEMPLATE. Copie para `.env` e preencha os valores reais.
#
#   cp .env.example .env
#   nano .env
#
# ⚠️  NUNCA faça commit do arquivo .env real. Já está no .gitignore.

# ── OBRIGATÓRIO: Domínio e TLS ──────────────────────────────────────────────
# Domínio onde o backend ficará acessível. Configure DNS A para o IP do VPS:
#   api.seudominio.com  →  IP_DO_SEU_VPS
DOMAIN=api.seudominio.com

# Email para registro Let's Encrypt. Você recebe alertas se cert expirar.
LETSENCRYPT_EMAIL=voce@seudominio.com

# ── OBRIGATÓRIO: Segredo JWT ────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com:  openssl rand -hex 32
# ⚠️  Se você mudar isso depois, todos os usuários precisam re-fazer login.
JWT_SECRET=CHANGE_ME_to_at_least_32_random_chars_use_openssl_rand_hex_32

# Tempo de expiração dos tokens (default: 7 dias)
JWT_EXPIRES_IN=7d

# ── OBRIGATÓRIO: Pelo menos um provider de IA ───────────────────────────────
# Você precisa de PELO MENOS UMA dessas keys. Múltiplas = fallback automático.
#
# OpenAI:
#   1. Crie conta em https://platform.openai.com
#   2. Adicione billing
#   3. Crie key em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude):
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq (mais rápido e barato, mas modelos open-source):
#   https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini):
#   https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista de origens permitidas, separadas por vírgula.
# Para a extensão Chrome funcionar, inclua chrome-extension://ID_DA_SUA_EXTENSAO
# Default: usa apenas o DOMAIN configurado acima.
CORS_ORIGINS=https://api.seudominio.com,chrome-extension://abcdef0123456789

# ── Pagamentos (opcional, mas necessário para SaaS) ─────────────────────────

# Stripe (recomendado para clientes internacionais):
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# MercadoPago (recomendado para clientes brasileiros):
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Email transacional (SendGrid recomendado):
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@seudominio.com

# ── Rate Limiting / Performance ─────────────────────────────────────────────

# Disable Redis se você quiser começar simples (não recomendado em produção).
# Quando desabilitado, rate limiter usa memória local — não funciona em multi-instance.
REDIS_DISABLED=false

# Concorrência do worker de IA (jobs simultâneos por worker)
WORKER_CONCURRENCY=5

# Limite de tenants ativos em memória ao mesmo tempo.
# Aumenta a RAM mas reduz cold-start. Para 100 clientes, 200 está OK.
ORCHESTRATOR_MAX_TENANTS=200

# TTL de tenant inativo na memória (após esse tempo, é evictado).
# Default: 30 minutos. Tenants frequentes ficam, raros saem.
ORCHESTRATOR_TTL_MS=1800000

# ── Logging ─────────────────────────────────────────────────────────────────

# error | warn | info | debug
LOG_LEVEL=info

# Sentry para monitoramento de erros em produção (recomendado):
#   1. Crie projeto em https://sentry.io
#   2. Cole o DSN aqui
SENTRY_DSN=

# ── Alertas em tempo real (recomendado para SaaS) ───────────────────────────
# Webhook que recebe POST com erros críticos (uncaught exceptions, AI offline, etc).
# Suporta:
#   - Discord:  https://discord.com/api/webhooks/ID/TOKEN
#   - Slack:    https://hooks.slack.com/services/T.../B.../X...
#   - Genérico: qualquer URL que aceite POST JSON
#
# Rate-limited internamente (max 5 alertas/h do mesmo tipo) — não vai te spammar.
ALERT_WEBHOOK_URL=

# Nome do app que aparece nos alertas (default: "WhatsHybrid Pro")
APP_NAME=WhatsHybrid Pro

# ── Webhooks de notificação para você ───────────────────────────────────────

# Webhook genérico (sua URL recebe POST com erros críticos):
WEBHOOK_SECRET=

# ── Configuração específica para SaaS multi-tenant ──────────────────────────

# Endpoint público da API (que extensão dos seus clientes vai chamar):
# Use o mesmo valor de DOMAIN com https://
PUBLIC_API_URL=https://api.seudominio.com

# Webhook de pagamento — secret compartilhado com gateway:
PAYMENT_WEBHOOK_SECRET=
